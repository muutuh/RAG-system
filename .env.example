# Copy this file to .env and fill in your OpenRouter key.
# .env is git-ignored; never commit it.

# --- Postgres (read by docker compose AND by the Python code) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag

DATABASE_URL=

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=paste-your-key-here

# Chat model that writes the answers.
LLM_MODEL=

# Embedding model. EMBED_DIM must match what this model outputs; it sets the size
# of the vector column. Changing the embedding model means re-ingesting everything.
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
